{
  "name": "liaowangtai",
  "private": true,
  "type": "module",
  "version": "3.0.0",
  "description": "GitHub Trending 日榜简报 · Nuxt 全栈单进程 + 本地 SQLite",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "preview": "nuxt build && node .output/server/index.mjs",
    "db:init": "node scripts/db-cli.mjs init",
    "db:seed": "node scripts/db-cli.mjs seed",
    "db:reset": "node scripts/db-cli.mjs reset",
    "db:info": "node scripts/db-cli.mjs info",
    "db:shell": "node scripts/db-cli.mjs shell",
    "crawl": "node scripts/crawl-once.mjs",
    "typecheck": "nuxt prepare && tsc -p .nuxt/tsconfig.server.json --noEmit && vue-tsc -p .nuxt/tsconfig.app.json --noEmit",
    "verify:sql": "node scripts/verify-sql.mjs",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "markdown-it": "^15.0.3",
    "nuxt": "^4.0.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.14"
  }
}