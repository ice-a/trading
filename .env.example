# 观澜志 · 环境变量（单机 SQLite）
# 复制成 .env 即可；shell / systemd 注入的同名变量优先。

# ── 数据库 ──
DB_PATH=data/app.db

# ── 抓取 ──
# 外部 cron 打 /api/crawl 时用的令牌；留空则不校验（仅限本机调试）
CRON_TOKEN=
UPDATE_INTERVAL_MINUTES=60
CRAWL_ON_BOOT=true
ENABLE_SCHEDULER=true

# ── 展示参数 ──
TRENDING_SINCE=daily
TRENDING_LANGUAGE=
TOP_N=10
PAGE_SIZE=10
APP_TIMEZONE=Asia/Shanghai

# ── 可选：提高 GitHub API 配额 ──
GITHUB_TOKEN=
