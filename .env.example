# ===== MongoDB 云数据库 =====
MONGODB_URI=mongodb://USER:PASSWORD@HOST1:27017,HOST2:27017,HOST3:27017/?ssl=true&replicaSet=REPLICA_SET&authSource=admin&appName=APP_NAME
MONGODB_DB=github_trending

# ===== 网络代理（本地/国内直连被墙时填；Vercel/Cloudflare 部署请留空 = 直连）=====
GITHUB_PROXY=
MONGO_PROXY_HOST=
MONGO_PROXY_PORT=7897

# ===== 更新频率（环境变量控制）=====
UPDATE_INTERVAL_MINUTES=60
CRAWL_ON_BOOT=true

# ===== 调度形态 =====
# auto  = 常驻 Node 进程用内置定时器；Serverless（Vercel/CF）自动关闭，改用外部 cron
# true  = 强制开内置定时器
# false = 强制关闭（只用 vercel.json / wrangler.toml / GitHub Actions 触发）
ENABLE_INTERNAL_SCHEDULER=auto

# ===== 榜单参数 =====
TRENDING_SINCE=daily
TRENDING_LANGUAGE=
TOP_N=10
PAGE_SIZE=10

# ===== 时区 =====
APP_TIMEZONE=Asia/Shanghai

# ===== 一言 =====
HITOKOTO_ENDPOINT=https://v1.hitokoto.cn/

# ===== 60s 聚合接口（/v2 页面的数据源）=====
FEEDS_BASE=https://60.020417.xyz
FEEDS_ENABLED=true

# ===== 触发 /api/crawl 的令牌 =====
# Vercel Cron 用 CRON_SECRET（平台会自动以 Authorization: Bearer 带上）
CRON_SECRET=
CRON_TOKEN=

# ===== 跨域白名单（前后端分离部署时填前端域名，默认 *）=====
APP_CORS_ORIGIN=*

# ===== 前后端分离部署时的后端地址（同源部署留空）=====
# 例：NUXT_PUBLIC_API_BASE=https://your-api.vercel.app
NUXT_PUBLIC_API_BASE=
# ---- Cloudflare DNS（可选）----
# 配置后 /dns 页面会直接读 Cloudflare 真实记录；留空则用数据库缓存
# Token 需要 Zone.DNS:Read 权限
CF_API_TOKEN=
# 多个 zone 用逗号分隔
CF_ZONE_IDS=

# ---- 后台管理密码（/admin）----
ADMIN_PASSWORD=admin123

# ---- GitHub API（可选，提高限额）----
GITHUB_TOKEN=

# ---- 60s API 站点根地址 ----
FEEDS_BASE=https://60.020417.xyz