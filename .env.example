# 瞭望台 · 单机部署环境变量（Nuxt 单进程 + SQLite + Caddy）
# 结构说明见 .env.example；生产环境用 systemd Environment= 覆盖敏感项亦可。

# ── 进程 ──
HOST=127.0.0.1
PORT=3000
DB_PATH=data/app.db

# ── 抓取调度（进程内定时器，不再需要 GitHub Actions / cron）──
UPDATE_INTERVAL_MINUTES=60
CRAWL_ON_BOOT=true
ENABLE_SCHEDULER=true

# ── 展示参数 ──
TRENDING_SINCE=daily
TRENDING_LANGUAGE=
TOP_N=10
PAGE_SIZE=10
APP_TIMEZONE=Asia/Shanghai
HITOKOTO_ENDPOINT=https://v1.hitokoto.cn/

# ── 60s 聚合接口 ──
FEEDS_BASE=https://60.020417.xyz
FEEDS_ENABLED=true

# ── 可选 ──
CRON_TOKEN=
ADMIN_PASSWORD=admin123
GITHUB_TOKEN=
# /dns 页面直读 Cloudflare（只读 DNS 即可）
CF_API_TOKEN=
CF_ZONE_IDS=
