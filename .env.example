# 瞭望台 · 环境变量
# 本地开发把本文件复制成 .env 即可；Vercel 上在 Project Settings → Environment Variables 里配。

# ── 数据库（二选一，自动判断）──
# 配了 TURSO_DATABASE_URL 就走远程 libSQL；否则读 DB_PATH（本地 SQLite 文件）。
# Vercel 没有持久磁盘，必须用远程库。
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# 本地 / 自建服务器用这个
DB_PATH=data/app.db

# ── 抓取 ──
# Vercel Cron 会自动带 Authorization: Bearer $CRON_SECRET
CRON_SECRET=
# 外部 cron / 手动 curl 用这个（打 /api/crawl?token=...）
CRON_TOKEN=
UPDATE_INTERVAL_MINUTES=60
CRAWL_ON_BOOT=true
ENABLE_SCHEDULER=true

# ── 展示参数 ──
TRENDING_SINCE=daily
TRENDING_LANGUAGE=
TOP_N=10
PAGE_SIZE=10
APP_TIMEZONE=Asia/Shanghai

# ── 可选 ──
GITHUB_TOKEN=
CF_API_TOKEN=
CF_ZONE_IDS=
