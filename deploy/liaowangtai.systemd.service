[Unit]
Description=Liaowangtai (Nuxt SSR + SQLite)
Documentation=https://github.com/ice-a/trading
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 改成实际运行用户（需要能写 DB_PATH 所在目录）
User=www-data
Group=www-data

WorkingDirectory=/opt/liaowangtai
# 运行时读取 .env（CRON_TOKEN / GITHUB_TOKEN 等）；前面的 - 表示文件不存在也不报错
EnvironmentFile=-/opt/liaowangtai/.env
Environment=NODE_ENV=production
# 只监听回环，外部入口统一走 Caddy
Environment=HOST=127.0.0.1
Environment=PORT=3000
Environment=DB_PATH=/opt/liaowangtai/data/app.db
# 512M 关键护栏：V8 老生代限 192M，避免抓取峰值把整机拖进 OOM。
# 1G 机器可改成 256。
Environment=NODE_OPTIONS=--max-old-space-size=192

ExecStart=/usr/bin/env node .output/server/index.mjs
Restart=always
RestartSec=5
# 冷启动要建表 / 开 WAL，给 30 秒
TimeoutStartSec=30

# ---- 512M 资源护栏 ----
# 注意 RSS 会高于 192M 的 V8 堆上限（还含 native/缓冲区），所以留到 400M
MemoryHigh=256M
MemoryMax=400M

# ---- 安全加固 ----
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/liaowangtai/data

[Install]
WantedBy=multi-user.target
